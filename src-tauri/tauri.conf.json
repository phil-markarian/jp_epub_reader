{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "JP EPUB Reader",
  "version": "0.1.0",
  "identifier": "dev.philm.jp_epub_reader",
  "build": {
    "beforeDevCommand": "cd frontend && trunk serve",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "cd frontend && trunk build",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "JP EPUB Reader",
        "width": 1100,
        "height": 750
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
